[Unit]
Description=Testbook Error Logger (FastAPI)
After=network.target

[Service]
Type=simple
User=testbook
Group=testbook
WorkingDirectory=/opt/testbook-error-logger/server
Environment="OLLAMA_URL=http://localhost:11434"
Environment="OLLAMA_MODEL=deepseek-v3.1:671b-cloud"
Environment="OLLAMA_TIMEOUT=180"
ExecStart=/opt/testbook-error-logger/server/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8787 --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
